{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siyasa",
  "main": "./server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "not_found_handling": "404-page", "run_worker_first": true },
  "routes": [
    { "pattern": "siyasa.deadpackets.pw", "custom_domain": true },
    { "pattern": "unitedstatesofjev.deadpackets.pw", "custom_domain": true }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "siyasa", "database_id": "779f53f6-9606-454e-a365-c24fb3aa009b", "migrations_dir": "server/migrations" }],
  "r2_buckets": [{ "binding": "PACKS", "bucket_name": "siyasa-packs" }],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VEC", "index_name": "siyasa-worlds" }],
  "durable_objects": { "bindings": [{ "name": "GATE", "class_name": "GateDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GateDO"] }],
  "workflows": [{ "name": "siyasa-build", "binding": "BUILD", "class_name": "WorldBuild" }],
  "vars": { "DAILY_BUILD_CAP": "10", "TURNSTILE_SITE_KEY": "0x4AAAAAAFXfSZm70FDICyyI" },
  "ratelimits": [{ "name": "RL", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } }]
}
